// 项目唯一的硬件声明文件。
// 所有内存都必须在这里声明；MPL/MIL 与包源码均不能读写它们。

const Screen0: Display = link("display1");
const Screen1: Display = link("display2");
const Screen2: Display = link("display3");
const Screen3: Display = link("display4");

export const MainScreen: Display = Display.combine([
    [Screen0, Screen1],
    [Screen2, Screen3]
]);

export const AlertBoard: Message = link("message1");

memory physical(
    link: "memory1",
    size: 512
);

// Pool 仅是链接器的布局策略，供 new 和包的内部需求统一分配。
memory virtual(
    size: 4096,
    mode: Pool
);
