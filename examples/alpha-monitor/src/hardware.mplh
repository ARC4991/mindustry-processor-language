// 项目唯一的硬件声明文件。
// 所有 Memory 都必须在这里声明；业务代码不需要也不能重新导入它们。

const Screen0: Display = link(0);
const Screen1: Display = link(1);
const Screen2: Display = link(2);
const Screen3: Display = link(3);

export const MainScreen: Display = Display.combine([
    [Screen0, Screen1],
    [Screen2, Screen3]
]);

export const AlertBoard: Message = link(4);

export const Data: Memory = Memory.physical(
    link: 5,
    size: 512
);

// Pool 内存供 new 分配的对象与注入给包的对象池使用。
export const Runtime: Memory = Memory.virtual(
    size: 4096,
    mode: Pool
);

// Manual 内存允许业务代码使用显式下标。
export const Scratch: Memory = Memory.virtual(
    size: 32,
    mode: Manual
);
