fun rotate(source: (Int, Float)): (Float, Int) {
    return (source[1], source[0]);
}
fun normalize(decimal: Bool): (Float, Float) {
    if (decimal) {
        return (1.5, 2);
    }
    return (1, 2.5);
}
fun rotateArray(values: Int[]): Int[] {
    return [values[2], values[0], values[1]];
}
fun sumArray(values: Int[]): Int {
    return ((values[0] + values[1]) + values[2]);
}
