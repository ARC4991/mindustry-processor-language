{
  "schemaVersion": 1,
  "id": "v146",
  "game": {
    "version": "146",
    "source": "Mindustry-146 源码审查"
  },
  "capabilities": ["baseline-logic", "unit-bind-cycle"],
  "limits": {
    "maxInstructions": 1000,
    "maxJumpLabels": 500,
    "maxTokensPerStatement": 16,
    "maxGraphicsBufferCommands": 256,
    "displayFlushCommandLimit": 1024,
    "maxMessageUtf16CodeUnits": 400,
    "maxDrawCoordinateMagnitude": 1023
  },
  "processors": {
    "micro": { "ipt": 2, "linkRange": 10, "permissions": ["normal"] },
    "logic": { "ipt": 8, "linkRange": 22, "permissions": ["normal"] },
    "hyper": { "ipt": 25, "linkRange": 42, "permissions": ["normal"] }
  },
  "hardware": {
    "memoryCell": { "capacity": 64 },
    "memoryBank": { "capacity": 512 }
  },
  "instructions": [
    { "opcode": "set", "operands": ["output", "value"], "permissions": ["normal"] },
    { "opcode": "op", "operands": ["operator", "output", "left", "right"], "permissions": ["normal"] },
    { "opcode": "jump", "operands": ["address", "condition", "left", "right"], "permissions": ["normal"] },
    { "opcode": "ubind", "operands": ["unitType"], "permissions": ["normal", "logicUnitControl"] },
    { "opcode": "ucontrol", "operands": ["action", "arguments"], "permissions": ["normal", "logicUnitControl"] },
    { "opcode": "print", "operands": ["value"], "permissions": ["normal"] },
    { "opcode": "printflush", "operands": ["message"], "permissions": ["normal"] },
    { "opcode": "drawflush", "operands": ["display"], "permissions": ["normal"] }
  ],
  "contents": {
    "units": [
      {
        "mplType": "Dagger",
        "mlogName": "dagger",
        "logicControllable": true,
        "fields": [
          { "name": "health", "type": "Float", "target": "@health" },
          { "name": "alive", "type": "Bool", "target": "!@dead" }
        ],
        "actions": [
          { "name": "move", "parameters": ["Float", "Float"], "target": "ucontrol move", "permissions": ["logicUnitControl"] }
        ]
      }
    ],
    "buildings": [
      {
        "mplType": "Duo",
        "mlogName": "duo",
        "fields": [
          { "name": "health", "type": "Float", "target": "@health" },
          { "name": "enabled", "type": "Bool", "target": "@enabled" }
        ],
        "actions": [
          { "name": "shoot", "parameters": ["Float", "Float", "Bool"], "target": "control shoot", "permissions": ["normal"] }
        ]
      }
    ]
  },
  "macros": [
    {
      "name": "@unit.each",
      "visibility": "public",
      "body": "required",
      "parameters": [
        { "name": "type", "type": "GameUnitType" },
        { "name": "binding", "type": "Unit" },
        { "name": "filters", "type": "UnitFilter[]" }
      ],
      "effects": ["readsWorld", "bindsUnit"],
      "maxCost": { "instructions": 24, "virtualSlots": 4, "physicalSlots": 0 },
      "lowering": ["ubind", "sensor", "jump"]
    },
    {
      "name": "@unit.move",
      "visibility": "public",
      "body": "none",
      "parameters": [
        { "name": "unit", "type": "Unit" },
        { "name": "x", "type": "Float" },
        { "name": "y", "type": "Float" }
      ],
      "effects": ["controlsUnit"],
      "maxCost": { "instructions": 1, "virtualSlots": 0, "physicalSlots": 0 },
      "lowering": ["ucontrol"]
    },
    {
      "name": "@unit.count",
      "visibility": "public",
      "body": "none",
      "parameters": [
        { "name": "type", "type": "GameUnitType" },
        { "name": "binding", "type": "UnitBinding" },
        { "name": "filters", "type": "UnitFilter[]" }
      ],
      "effects": ["readsWorld", "bindsUnit"],
      "maxCost": { "instructions": 18, "virtualSlots": 5, "physicalSlots": 0 },
      "lowering": ["ubind", "sensor", "op", "jump"]
    },
    {
      "name": "@unit.get",
      "visibility": "public",
      "body": "none",
      "parameters": [
        { "name": "type", "type": "GameUnitType" },
        { "name": "binding", "type": "UnitBinding" },
        { "name": "index", "type": "Int" },
        { "name": "filters", "type": "UnitFilter[]" }
      ],
      "effects": ["readsWorld", "bindsUnit", "createsUnitRef"],
      "maxCost": { "instructions": 24, "virtualSlots": 8, "physicalSlots": 0 },
      "lowering": ["ubind", "sensor", "op", "jump", "set"]
    },
    {
      "name": "@unit.refRead",
      "visibility": "public",
      "body": "none",
      "parameters": [
        { "name": "unit", "type": "UnitRef" },
        { "name": "field", "type": "UnitField" }
      ],
      "effects": ["readsWorld", "bindsUnit"],
      "maxCost": { "instructions": 4, "virtualSlots": 1, "physicalSlots": 0 },
      "lowering": ["ubind", "jump", "sensor"]
    },
    {
      "name": "@unit.refAlive",
      "visibility": "public",
      "body": "none",
      "parameters": [
        { "name": "unit", "type": "UnitRef" }
      ],
      "effects": ["readsWorld", "bindsUnit"],
      "maxCost": { "instructions": 5, "virtualSlots": 1, "physicalSlots": 0 },
      "lowering": ["ubind", "jump", "sensor", "op"]
    },
    {
      "name": "@unit.refMove",
      "visibility": "public",
      "body": "none",
      "parameters": [
        { "name": "unit", "type": "UnitRef" },
        { "name": "x", "type": "Float" },
        { "name": "y", "type": "Float" }
      ],
      "effects": ["controlsUnit", "bindsUnit"],
      "maxCost": { "instructions": 5, "virtualSlots": 1, "physicalSlots": 0 },
      "lowering": ["ubind", "sensor", "jump", "ucontrol"]
    },
    {
      "name": "@io.print",
      "visibility": "public",
      "body": "none",
      "parameters": [
        { "name": "message", "type": "GameLink<Message>" },
        { "name": "values", "type": "PrintValue[]" }
      ],
      "effects": ["writesMessage", "flushesMessage"],
      "maxCost": { "instructions": 2, "virtualSlots": 0, "physicalSlots": 0 },
      "lowering": ["print", "printflush"]
    },
    {
      "name": "@io.drawFlush",
      "visibility": "runtimePrivate",
      "body": "none",
      "parameters": [
        { "name": "display", "type": "GameLink<Display>" }
      ],
      "effects": ["flushesGraphicsBuffer"],
      "maxCost": { "instructions": 1, "virtualSlots": 0, "physicalSlots": 0 },
      "lowering": ["drawflush"]
    }
  ]
}
