{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arc4991.github.io/mpl/schema/部署清单.schema.json",
  "title": "MPL 多处理器部署清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compiler", "inputDigest", "targetProfile", "layoutFingerprint", "runtimeTopology", "externalHardware", "logicalDisplays", "prerequisites"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "compiler": { "type": "object", "additionalProperties": false, "required": ["version"], "properties": { "version": { "type": "string" } } },
    "inputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetProfile": { "type": "string" },
    "layoutFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeTopology": { "$ref": "#/$defs/topology" },
    "externalHardware": { "type": "array", "items": { "$ref": "#/$defs/externalHardware" } },
    "logicalDisplays": { "type": "array", "items": { "$ref": "#/$defs/logicalDisplay" } },
    "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/prerequisite" } }
  },
  "$defs": {
    "topology": {
      "type": "object", "additionalProperties": false,
      "required": ["shards", "memorySegments"],
      "properties": {
        "blueprint": { "$ref": "#/$defs/blueprint" },
        "shards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shard" } },
        "memorySegments": { "type": "array", "items": { "$ref": "#/$defs/memory" } },
        "sharedRuntime": { "$ref": "#/$defs/sharedRuntime" }
      }
    },
    "sharedRuntime": {
      "type": "object", "additionalProperties": false,
      "required": ["magic", "abiVersion", "fingerprint", "epoch", "mainShard", "workers", "slots", "readyIndex", "acknowledgementIndexes", "heartbeatIndexes", "slices", "mailboxes", "tasks"],
      "properties": {
        "magic": { "type": "integer", "minimum": 1 },
        "abiVersion": { "type": "integer", "minimum": 1 },
        "fingerprint": { "type": "integer", "minimum": 1 },
        "epoch": { "type": "integer", "minimum": 1 },
        "mainShard": { "type": "string" },
        "workers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "slots": { "type": "integer", "minimum": 7 },
        "readyIndex": { "type": "integer", "minimum": 0 },
        "acknowledgementIndexes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "heartbeatIndexes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "slices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runtimeSlice" } },
        "mailboxes": { "type": "array", "items": { "$ref": "#/$defs/mailbox" } },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "worker", "kind", "parameterSlots", "returnSlots", "parameterTypes", "returnType"],
      "properties": {
        "function": { "type": "string" },
        "worker": { "type": "string" },
        "kind": { "type": "integer", "minimum": 1, "maximum": 2000000000 },
        "parameterSlots": { "type": "integer", "minimum": 0 },
        "returnSlots": { "const": 1 },
        "estimatedInstructions": { "type": "integer", "minimum": 0 },
        "estimatedLabels": { "type": "integer", "minimum": 0 },
        "parameterTypes": { "type": "array", "items": { "enum": ["Int", "Float", "Bool"] } },
        "returnType": { "enum": ["Int", "Float", "Bool"] }
      }
    },
    "mailbox": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "producer", "consumer", "payloadSlots", "slots", "slices"],
      "properties": {
        "id": { "type": "string" },
        "producer": { "type": "string" },
        "consumer": { "type": "string" },
        "payloadSlots": { "type": "integer", "minimum": 0 },
        "slots": { "type": "integer", "minimum": 3 },
        "slices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runtimeSlice" } }
      }
    },
    "runtimeSlice": {
      "type": "object", "additionalProperties": false,
      "required": ["memory", "offset", "logicalStart", "length"],
      "properties": {
        "memory": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "logicalStart": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "blueprint": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "blocks"],
      "properties": {
        "file": { "type": "string", "pattern": "\\.msch$" },
        "blocks": { "type": "array", "items": { "type": "string", "enum": ["processor", "memory"] }, "uniqueItems": true }
      }
    },
    "shard": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "processor", "mlog", "roles", "blueprintPosition"],
      "properties": {
        "id": { "type": "string" },
        "processor": { "type": "string" },
        "mlog": { "type": "string", "pattern": "\\.mlog$" },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "blueprintPosition": { "$ref": "#/$defs/position" }
      }
    },
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "capacity", "usedSlots", "blueprintPosition", "bindings"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["cell", "bank"] },
        "capacity": { "type": "integer", "minimum": 1 },
        "usedSlots": { "type": "integer", "minimum": 0 },
        "blueprintPosition": { "$ref": "#/$defs/position" },
        "bindings": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["shard", "alias", "access", "autoConnected"], "properties": { "shard": { "type": "string" }, "alias": { "type": "string" }, "access": { "enum": ["read", "write", "readWrite"] }, "autoConnected": { "type": "boolean" } } } }
      }
    },
    "externalHardware": {
      "type": "object", "additionalProperties": false,
      "required": ["mplName", "ownerShard", "alias", "type", "access"],
      "properties": {
        "mplName": { "type": "string" },
        "ownerShard": { "type": "string" },
        "alias": { "type": "string" },
        "type": { "type": "string" },
        "access": { "enum": ["read", "write", "readWrite"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "logicalDisplay": {
      "type": "object", "additionalProperties": false,
      "required": ["mplName", "width", "height", "tiles"],
      "properties": {
        "mplName": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/displayTile" } }
      }
    },
    "displayTile": {
      "type": "object", "additionalProperties": false,
      "required": ["mplName", "alias", "x", "y", "width", "height"],
      "properties": {
        "mplName": { "type": "string" },
        "alias": { "type": "string" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "prerequisite": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": { "kind": { "type": "string" }, "value": {} }
    }
  }
}
